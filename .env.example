# =====================================================================
# Agent Triager — environment template. Copy to .env and fill in.
# NEVER commit real secrets. .env is gitignored.
# =====================================================================

# ---- Azure DevOps ----
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PROJECT=YourProject
ADO_QUERY_NAME=TEAM_SPRINT_QUERY
ADO_API_VERSION=7.1

# Dev auth mode: entra | pat | azcli
#   entra  -> uses AAD app registration (user_impersonation) [chosen]
#   pat    -> uses ADO_PAT (dev convenience only)
#   azcli  -> uses your `az login` identity (no app reg needed) [dev fallback]
ADO_AUTH_MODE=azcli
# ADO_PAT=                      # dev only, never commit
AAD_TENANT_ID=
AAD_CLIENT_ID=
# ADO resource scope (constant): 499b84ac-1321-427f-aa17-267ca6975798/.default

# ---- AI provider ----
# azure-openai | openai | mock
AI_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REALTIME_DEPLOYMENT=
AZURE_OPENAI_REASONING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# OPENAI_API_KEY=

# ---- Program config ----
PROGRAM_CONFIG=config/program.PROGRAM_A.json

# ---- Backend (agenttriager) ----
PORT=8787
NODE_ENV=development
